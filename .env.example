NODE_ENV=development
PORT=3000
APP_NAME=admission-portal
API_PREFIX=api/v1

# --- Local Postgres (default) ---
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_USER=admissions
# DATABASE_PASSWORD=admissions
# DATABASE_NAME=admissions

# --- Nhost Postgres ---
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@YOUR_SUBDOMAIN.db.REGION.nhost.run:5432/postgres
DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=false

# --- Base Platform IAM ---
IAM_BASE_URL=https://taleem-ai-cms-base-module-production.up.railway.app/api/v1
BASE_PLATFORM_URL=
BASE_PLATFORM_APP_CODE=ADM-F000
DEFAULT_TENANT_ID=01a0a01c-0ca7-72f3-82f9-8d1ca1bdc952

# OAuth client registered in IAM for this app (must match IAM JWT_ACCESS_SECRET)
VITE_ADMIN_OAUTH_CLIENT_ID=admission-portal
VITE_ADMIN_OAUTH_CLIENT_SECRET=AdmissionAdminClientSecret2026!
VITE_ADMIN_PORTAL_CALLBACK=http://localhost:3000/callback
# Optional aliases:
# OAUTH_ADMIN_CLIENT_ID=admission-portal
# OAUTH_ADMIN_CLIENT_SECRET=AdmissionAdminClientSecret2026!
# OAUTH_ADMIN_REDIRECT_URI=http://localhost:3000/callback
# Leave empty if application_scopes is not seeded for this OAuth client.
# When set, every scope must exist in IAM application_scopes for the app.
OAUTH_SCOPE=

# Must match Base Platform IAM JWT_ACCESS_SECRET
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Storage: local | b2 | s3 | minio (same Backblaze B2 as alumni CMS)
STORAGE_DRIVER=b2
S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
S3_REGION=us-east-005
S3_ACCESS_KEY=your-key-id
S3_SECRET_KEY=your-application-key
S3_BUCKET=taleem-alumni
S3_FORCE_PATH_STYLE=true
S3_SIGNED_URLS=true
S3_SIGNED_URL_TTL_SECONDS=604800
S3_PUBLIC_URL=https://f005.backblazeb2.com/file/taleem-alumni
PUBLIC_BASE_URL=http://localhost:3000

# Comma-separated browser origins allowed to call the API
# (plus localhost, *.ngrok*, and *.vercel.app by default).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://taleem-admin-admission.vercel.app

# Admin portal page opened when an admit-card QR is scanned (no trailing slash).
# Default matches Vite admin `frontend` on port 5173.
F006_ATTENDANCE_PAGE_URL=http://localhost:5173/attendance/qr

# Max programme preferences per application (minimum 2)
APPLICATION_MAX_PROGRAMME_PREFERENCES=2
